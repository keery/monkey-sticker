# Copie ce fichier en .env.local, puis démarre la base :
#   docker compose up -d
# (voir docker-compose.yml — conteneur flapy-postgres sur le port 5434)
DATABASE_URL=postgres://flapy:flapy@localhost:5434/flapy

# Premier admin semé au démarrage (idempotent). Voir .env.local.example.
ADMIN_EMAIL=admin@monkeysticker.fr
ADMIN_PASSWORD=change-moi
# E-mail transactionnel (mot de passe oublié) — vide = lien loggé en dev.
RESEND_API_KEY=
EMAIL_FROM=Monkey Sticker <no-reply@monkeysticker.fr>
